APP_NAME=乡音智谱 · 乡村音乐教室 AI 教学助手
APP_ENV=development
# 本地默认使用 SQLite。连接 Supabase 时，替换为 Connect 中 SQLAlchemy / Session pooler 给出的 URI。
# 真实连接串只放在本机 .env 或后端平台密钥中，不要提交到 GitHub。
DATABASE_URL=sqlite:///./data/zhiban.db
UPLOAD_DIR=./data/uploads
# 单个课堂录音或参考音频的最大上传字节数；请求总大小上限约为两个文件之和。
AUDIO_MAX_UPLOAD_BYTES=104857600
# Private Supabase Storage bucket for shared audio/score/media objects.
# Keep the service role key only in backend/.env and hosted backend environment variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teacher-media
FRONTEND_DIR=../frontend
# 生产环境填写允许调用后端的完整前端 origin，逗号分隔；Cookie 会话使用跨站部署时启用 Secure。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-5.3-flash
AI_FAST_MODEL=doubao-seed-2-0-mini-260428
AI_FAST_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_FAST_API_KEY=
# 仅 GLM-5.3/GLM-5.3-Flash 使用；可选 low/high/max。high/max 会把输出额度大量耗在内部推理上。
AI_REASONING_EFFORT=low
AI_FAST_REASONING_EFFORT=low
AI_MAX_TOKENS=32768
AI_FAST_MAX_TOKENS=32768
# 可选：课堂整体分析会先提取分段声学证据，再由已配置的模型把证据整理成教学建议。
# 不会让模型计算分数；AI_FAST_API_KEY 未填写时会使用 AI_API_KEY 对应的深度模型。
CLASSROOM_INSIGHT_ENABLED=true
CLASSROOM_INSIGHT_MAX_TOKENS=1800
# 可选：启用 PNG/JPG/PDF 五线谱识别。安装官方 Audiveris 后填启动命令。
# 官方 Windows 安装包通常是 bin\\Audiveris.bat；如果你的版本只有 Audiveris.exe，直接填写 .exe。
# 也可以填写 Java 启动命令：java -jar "C:\\path\\Audiveris.jar"
# 示例：AUDIVERIS_COMMAND=C:\\Program Files\\Audiveris\\bin\\Audiveris.bat
AUDIVERIS_COMMAND=
OMR_TIMEOUT_SECONDS=180
# 专业单人练唱：可选安装 requirements-audio-pro.txt 后，原唱/伴奏混音会先经 Demucs 分离人声。
# 未安装时系统不会把混音误判成逐音目标，而会返回明确的“不可评分”原因。

# 可选：安装独立人声分离器后可指定其可执行路径；留空会自动检测仓库根目录 .audio-separator-venv。
# AUDIO_SEPARATOR_COMMAND=
# 首选 BS-RoFormer 模型；模型权重首次运行时下载到本机缓存。
AUDIO_SEPARATOR_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
