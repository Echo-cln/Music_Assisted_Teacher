APP_NAME=乡音智谱 · 乡村音乐教室 AI 教学助手
APP_ENV=development
DATABASE_URL=sqlite:///./data/zhiban.db
UPLOAD_DIR=./data/uploads
FRONTEND_DIR=../frontend
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-5.3-flash
AI_FAST_MODEL=doubao-seed-2-0-mini-260428
AI_FAST_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_FAST_API_KEY=
# 可选：启用 PNG/JPG/PDF 五线谱识别。安装官方 Audiveris 后填可执行文件路径。
# Windows 官方启动脚本示例：AUDIVERIS_COMMAND=C:\\Program Files\\Audiveris\\bin\\Audiveris.bat
AUDIVERIS_COMMAND=
OMR_TIMEOUT_SECONDS=180
