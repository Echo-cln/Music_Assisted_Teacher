# Copy this file to the deployment host as .env, then replace every placeholder.
# Never commit the filled .env file.
APP_ENV=production

# Supabase Dashboard -> Connect -> ORMs -> SQLAlchemy -> Session pooler.
# URL-encode special characters in the database password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Supabase Dashboard -> Project Settings -> API (or API Keys).
# Keep the service role / secret key on the backend only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teacher-media

# Exact origin of the EdgeOne site; no trailing slash.
ALLOWED_ORIGINS=https://music-assisted-teacher-qiszkhgt.edgeone.cool
SESSION_COOKIE_SECURE=true

# AI providers. Leave a key empty only if that model mode is not needed.
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-5.3-flash
AI_FAST_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_FAST_API_KEY=
AI_FAST_MODEL=doubao-seed-2-0-mini-260428

# Optional email verification settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
